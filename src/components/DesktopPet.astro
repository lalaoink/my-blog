---
// ============================================================
//  网页桌宠 · 艾雅法拉（明日方舟）
//
//  模型：Arknights 基建小人（Spine 3.8 骨骼动画）
//    来源 https://github.com/isHarryh/Ark-Models  （models/180_amgoat）
//    运行时 https://github.com/EsotericSoftware/spine-runtimes （tag 3.8）
//    ⚠️ 版权与许可说明见 public/pet-eyja/NOTICE.txt
//
//  实测动画（6 组）：
//    Default   0.00s  ← 纯静止姿势，没有任何动作
//    Interact  1.20s  互动
//    Relax     2.00s  放松
//    Move      3.00s  行走
//    Sit       3.33s  坐下
//    Sleep     3.33s  睡觉  ← ⚠️ 未使用，见下方说明
//
//  ⚠️ 为什么不用 Sleep：这个动作会让角色**横躺着**，宽度接近身高的两倍。
//     要完整放下它，画布得宽一倍，站姿就会小得看不清五官 —— 不值当。
//     所以长时间挂机只用 Sit（坐在地上），观感上同样是"休息了"。
//
//  ⚠️ spine-core.js / spine-canvas.js 是 UMD 全局脚本，不是 ES 模块，
//     必须用 is:inline 保留成普通 script 标签。
// ============================================================
---

<div id="pet-root" class="pet-root">
  <div id="pet-bubble" class="pet-bubble" role="status" aria-live="polite"></div>
  <div class="pet-scale">
    <canvas
      id="pet-canvas"
      class="pet-canvas"
      role="button"
      tabindex="0"
      aria-label="艾雅法拉桌宠：点击或按回车和她说话，也可以按住拖动"
      title="点我 / 拖我"
    ></canvas>
  </div>
</div>

<!-- 运行时：普通脚本，先于下面的模块脚本执行 -->
<script is:inline src="/pet-eyja/spine-core.js"></script>
<script is:inline src="/pet-eyja/spine-canvas.js"></script>

<style>
  .pet-root {
    position: fixed;
    /* 静止位置交给 CSS；只在真正移动时才切换成 left/top */
    right: 18px;
    bottom: 10px;
    z-index: 9999;
    pointer-events: none;
    will-change: left, top;
  }

  .pet-scale {
    transform: scale(var(--pet-scale, 1));
    transform-origin: bottom right;
  }

  .pet-canvas {
    /* 显示尺寸。内部像素尺寸由 JS 按 devicePixelRatio 设置，保证清晰。
       画布比模型本身大一圈（四周留了余量），避免动画中部件超出被切。 */
    width: 170px;
    height: 203px;
    display: block;
    cursor: grab;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.22));
    /* ★ 常驻的轻微呼吸/晃动。
       Default 动画时长是 0 秒（完全静止），只靠它撑不住"活着"的感觉，
       所以叠一层 CSS 动效，保证鼠标不激活时也在自然晃动。 */
    animation: pet-breathe 4.2s ease-in-out infinite;
    transform-origin: 50% 92%;
  }
  @keyframes pet-breathe {
    0%,
    100% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
    35% {
      transform: translateY(-2.5px) rotate(-0.75deg) scale(1.006);
    }
    68% {
      transform: translateY(1.5px) rotate(0.55deg) scale(0.996);
    }
  }

  .pet-canvas:hover {
    filter: drop-shadow(0 8px 16px rgba(49, 111, 211, 0.4));
  }
  .pet-canvas.dragging {
    cursor: grabbing;
    animation-play-state: paused;
  }
  .pet-canvas:focus-visible {
    outline: 2px solid var(--sea-blue, #316fd3);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .pet-bubble {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translate(-50%, 6px) scale(0.96);
    margin-bottom: 6px;
    width: max-content;
    max-width: 220px;
    background: #fff;
    color: var(--very-dark-gray, #222);
    border: 2px solid var(--very-dark-gray, #222);
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 13px;
    line-height: 1.4;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
    text-align: center;
    font-family: var(--mono-basic, sans-serif);
  }
  .pet-bubble.show {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  /* 小屏缩放 */
  @media (max-width: 600px) {
    .pet-root { --pet-scale: 0.56; }
    .pet-bubble { max-width: 150px; font-size: 12px; }
  }
  /* 中等宽度时略降不透明度，避免压住正文 */
  @media (max-width: 1000px) {
    .pet-canvas { opacity: 0.88; }
    .pet-canvas:hover,
    .pet-canvas.dragging { opacity: 1; }
  }

  /* 尊重「减少动态效果」偏好：关掉常驻晃动 */
  @media (prefers-reduced-motion: reduce) {
    .pet-canvas {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  // ============================================================
  //  这一段会发到浏览器执行。它等全局 spine 就绪后再初始化。
  // ============================================================

  // 模型在 setup pose 下的包围盒：x ∈ [-162, 100]，y ∈ [-4, 381]
  const MODEL_LEFT = -162;
  const MODEL_RIGHT = 100;
  const MODEL_BOTTOM = -4;
  const MODEL_TOP = 381;

  // ★ 画布四周留出余量。
  //   原来画布正好等于 setup pose 的包围盒（262x385），一像素余量都没有 ——
  //   动画中头发/手臂稍微超出就被硬生生切掉，就是"两边裁切过的痕迹"。
  //   实测余量需求（遍历整段动画取最坏值）：
  //     Default/Relax/Move 各方向 ≤ 40；Interact 会向左伸展到贴边；
  //     Sit 会向下沉约 112（所以额外用 LIFT 把它提回地面）
  const PAD_X = 56;
  const PAD_TOP = 36;
  const PAD_BOTTOM = 26;

  const CANVAS_W = MODEL_RIGHT - MODEL_LEFT + PAD_X * 2; // 374
  const CANVAS_H = MODEL_TOP - MODEL_BOTTOM + PAD_TOP + PAD_BOTTOM; // 447

  // 骨骼原点放在脚底，所以要把原点偏移到「左边距 - 模型最左」处
  const ORIGIN_X = PAD_X - MODEL_LEFT; // 218
  const ORIGIN_Y = CANVAS_H - PAD_BOTTOM - MODEL_BOTTOM; // 417

  // 某些动作会让角色整体下移，需要把它提回来，否则会沉出画布。
  // 数值由实测得出（Sit 的最低点比 setup pose 低约 112）。
  const LIFT = {
    sit: 112,
  };

  const DISPLAY_W = 170;
  const DISPLAY_H = 203;

  /** 状态 → Spine 动画名（Sleep 刻意不用，理由见文件头注释） */
  const ANIM = {
    idle: "Default",
    walk: "Move",
    sit: "Sit",
    relax: "Relax",
    interact: "Interact",
  };

  /** 空闲时偶尔自己播一下的小动作，让它显得有生气 */
  const IDLE_FIDGETS = ["Relax", "Interact"];

  const QUOTES = [
    "我是艾雅法拉，火山学家。",
    "博士，今天也来写点什么吗？",
    "嗯……这段代码我看懂了！",
    "别熬夜，源石虫也要休息的。",
    "要不要去「文章」看看？",
    "拖我可以换位置哦。",
    "这一带的地质构造很有意思。",
    "写不出来就先散个步吧。",
    "我的听力不太好……你说大声点？",
  ];

  const root = document.getElementById("pet-root");
  const canvas = document.getElementById("pet-canvas");
  const bubble = document.getElementById("pet-bubble");
  if (!root || !canvas || !bubble) throw new Error("pet elements missing");

  const status = (s) => root.setAttribute("data-status", s);
  status("start");

  // ---------- 位置状态 ----------
  let posX = 0;
  let posY = 0;
  let positioned = false;

  function currentScale() {
    const v = getComputedStyle(root).getPropertyValue("--pet-scale").trim();
    const n = parseFloat(v);
    return Number.isFinite(n) && n > 0 ? n : 1;
  }
  function petSize() {
    const s = currentScale();
    const r = canvas.getBoundingClientRect();
    return { w: r.width || DISPLAY_W * s, h: r.height || DISPLAY_H * s };
  }
  function clampPosition() {
    const { w, h } = petSize();
    posX = Math.min(Math.max(posX, 0), Math.max(0, window.innerWidth - w));
    posY = Math.min(Math.max(posY, 0), Math.max(0, window.innerHeight - h));
  }
  function applyPosition() {
    root.style.left = `${posX}px`;
    root.style.top = `${posY}px`;
  }
  function ensurePositioned() {
    if (positioned) return;
    const r = root.getBoundingClientRect();
    // ⚠️ 必须夹取范围：读到的瞬间可能还没反映 CSS 的 right/bottom 定位
    const w = r.width || canvas.getBoundingClientRect().width || DISPLAY_W;
    const h = r.height || canvas.getBoundingClientRect().height || DISPLAY_H;
    posX = Math.min(Math.max(r.left, 0), Math.max(0, window.innerWidth - w));
    posY = Math.min(Math.max(r.top, 0), Math.max(0, window.innerHeight - h));
    root.style.right = "auto";
    root.style.bottom = "auto";
    applyPosition();
    positioned = true;
  }
  window.addEventListener("resize", () => {
    if (!positioned) return;
    clampPosition();
    applyPosition();
  });

  // ---------- 加载运行时 ----------
  function waitForSpine(timeoutMs = 8000) {
    return new Promise((resolve, reject) => {
      const t0 = performance.now();
      (function poll() {
        if (window.spine && window.spine.canvas && window.spine.SkeletonBinary) {
          resolve(window.spine);
        } else if (performance.now() - t0 > timeoutMs) {
          reject(new Error("spine runtime not available"));
        } else {
          requestAnimationFrame(poll);
        }
      })();
    });
  }

  // ---------- 状态 ----------
  let skeleton = null;
  let animState = null;
  let renderer = null;
  let ctx2d = null;
  let ready = false;
  let dpr = 1;

  let state = "";
  let busyUntil = 0;
  let idleSince = performance.now();
  let facing = 1;
  let dragging = false;
  let last = performance.now();
  let wanderTimer = null;
  let drawCount = 0;

  // ---------- 鼠标跟随（用于"看向鼠标"） ----------
  const LOOK_DEADZONE = 46; // 死区，px：鼠标在正前方附近时保持朝向不变
  const LOOK_EASE = 0.08; // 平滑系数，越小越慢
  let mouseX = 0;
  let mouseY = 0;
  let mouseSeen = false;
  const look = { x: 0, y: 0 };

  window.addEventListener(
    "pointermove",
    (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      mouseSeen = true;
    },
    { passive: true }
  );
  // 光标离开窗口就不再跟随
  document.addEventListener("mouseleave", () => {
    mouseSeen = false;
  });
  document.addEventListener("mouseenter", () => {
    mouseSeen = true;
  });

  function setupCanvas() {
    canvas.width = CANVAS_W * dpr;
    canvas.height = CANVAS_H * dpr;
    canvas.style.width = DISPLAY_W + "px";
    canvas.style.height = DISPLAY_H + "px";
  }

  function setState(name) {
    if (!ready) return;
    if (state === name) return;
    state = name;
    const anim = ANIM[name];
    if (!anim) return;

    if (name === "interact") {
      // 一次性动作，播完自动回到待机
      animState.setAnimation(0, anim, false);
      animState.addAnimation(0, ANIM.idle, true, 0);
      busyUntil = performance.now() + 1200;
    } else {
      // idle / walk / sit / sleep / relax 都循环
      animState.setAnimation(0, anim, true);
      busyUntil = 0;
    }
  }

  function say(text) {
    bubble.textContent = text;
    bubble.classList.add("show");
    clearTimeout(say._t);
    say._t = setTimeout(() => bubble.classList.remove("show"), 2600);
  }

  /** 画一帧。
   *  ⚠️ SkeletonRenderer 自己【不会清屏】—— clearRect 在 spine-canvas.js 里出现 0 次。
   *     不清的话每帧都叠在上一帧上，看起来就是重影 / 拖尾。 */
  function drawFrame(dt, nowMs) {
    ctx2d.clearRect(0, 0, canvas.width, canvas.height);
    animState.update(dt);
    animState.apply(skeleton);

    // ★ 骨骼级微动作：在动画之上再叠加，做出"活着的 NPC"的感觉。
    //   Default 动画时长是 0 秒（纯静止姿势），只靠它撑不住生气。
    applyIdleMotion(skeleton, nowMs);
    applyLookAt(skeleton);
    // 朝向：向左走时水平翻转整个模型
    skeleton.scaleX = facing * dpr;
    // 坐下等动作会让角色整体下沉，这里提回地面线
    skeleton.y = (ORIGIN_Y + (LIFT[state] || 0)) * dpr;
    skeleton.updateWorldTransform();
    renderer.draw(skeleton);
  }

  function clampNum(v, a, b) {
    return Math.min(Math.max(v, a), b);
  }

  /** 缓慢的呼吸 / 重心摇摆：一直不停，幅度很小 */
  function applyIdleMotion(sk, nowMs) {
    const t = nowMs / 1000;
    // 两个不同频率的正弦叠加，避免看起来像机械钟摆
    const breathe = Math.sin(t * 2.6); // 呼吸，约 2.4 秒一轮
    const sway = Math.sin(t * 1.14); // 重心轻摆，约 5.5 秒一轮

    const rootBone = sk.findBone("bone") || sk.findBone("root");
    const chest = sk.findBone("F_chest");
    const head = sk.findBone("F_head");

    if (rootBone) rootBone.y += breathe * 1.2;
    if (chest) chest.rotation += sway * 1.5;
    if (head) head.rotation += sway * 1.1 + Math.sin(t * 0.83) * 0.8;
  }

  /** 看向鼠标：转头 + 眼睛偏移 + 眉毛起伏，并据此决定整体朝向 */
  function applyLookAt(sk) {
    if (!mouseSeen) return;
    const r = canvas.getBoundingClientRect();
    if (!r.width) return;

    const cx = r.left + r.width / 2;
    const cy = r.top + r.height * 0.32; // 头部大致所在的高度
    const dx = mouseX - cx;
    const dy = mouseY - cy;

    // 只在待机/坐下时跟随，走动或拖拽时不要抢朝向
    if (!dragging && state !== "walk") {
      // 死区：鼠标在正中间时不来回横跳
      if (dx < -LOOK_DEADZONE) facing = -1;
      else if (dx > LOOK_DEADZONE) facing = 1;
    }
    // 整体翻转之后，旋转的视觉方向是反的，所以乘 facing
    const flip = facing;

    const tx = clampNum(dx / 420, -1, 1) * flip;
    const ty = clampNum(dy / 420, -1, 1);

    // 平滑逼近，避免鼠标一动头就瞬移
    look.x += (tx - look.x) * LOOK_EASE;
    look.y += (ty - look.y) * LOOK_EASE;

    const head = sk.findBone("F_head");
    const chest = sk.findBone("F_chest");
    if (head) head.rotation += look.x * 13 + look.y * 1.5;
    if (chest) chest.rotation += look.x * 4;

    // 眼睛：小幅偏移，制造"视线跟着你"的感觉
    const eyeL = sk.findBone("F_L_eye");
    const eyeR = sk.findBone("F_R_eye");
    for (const eye of [eyeL, eyeR]) {
      if (!eye) continue;
      eye.x += look.x * 1.6 * flip;
      eye.y += look.y * 1.2;
    }
    // 眉毛：跟着上下轻微起伏，多一点表情
    const browL = sk.findBone("F_L_eyebrow");
    const browR = sk.findBone("F_R_eyebrow");
    for (const b of [browL, browR]) {
      if (!b) continue;
      b.y += look.y * 0.8;
    }
  }

  function scheduleWander(delay) {
    clearTimeout(wanderTimer);
    wanderTimer = setTimeout(wander, delay);
  }

  // ---------- 主循环 ----------
  function tick(now) {
    const dt = Math.min((now - last) / 1000, 0.1);
    last = now;

    if (ready) {
      if (busyUntil && now > busyUntil) {
        busyUntil = 0;
        setState("idle");
        idleSince = now;
      }

      // 挂机久了就坐下（Sleep 会让角色横躺，画布放不下，见文件头说明）
      if (!dragging && !busyUntil) {
        const idleFor = now - idleSince;
        if (state === "idle" && idleFor > 30000) setState("sit");
      }

      drawFrame(dt, now);

      drawCount++;
      if (drawCount % 30 === 0) {
        status("drawing#" + drawCount + ",state=" + state);
      }
    }
    requestAnimationFrame(tick);
  }

  // ---------- 互动 1：随机散步 ----------
  function wander() {
    if (!ready || dragging || busyUntil || state === "sit") {
      scheduleWander(5000);
      return;
    }
    ensurePositioned();

    const dir = Math.random() < 0.5 ? -1 : 1;
    facing = dir;
    setState("walk");

    const { w } = petSize();
    const fromX = posX;
    const targetX = Math.min(
      Math.max(posX + dir * (40 + Math.random() * 130), 0),
      Math.max(0, window.innerWidth - w)
    );
    const duration = 1200 + Math.random() * 900;
    const t0 = performance.now();

    function step(now) {
      const p = Math.min((now - t0) / duration, 1);
      const ease = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
      posX = fromX + (targetX - fromX) * ease;
      applyPosition();
      if (p < 1) requestAnimationFrame(step);
      else {
        setState("idle");
        idleSince = performance.now();
        scheduleWander(4000 + Math.random() * 6000);
      }
    }
    requestAnimationFrame(step);
  }

  // ---------- 互动 2：空闲时的小动作 ----------
  function fidget() {
    if (!ready || dragging || busyUntil || state !== "idle") {
      scheduleFidget(9000);
      return;
    }
    animState.setAnimation(
      0,
      IDLE_FIDGETS[Math.floor(Math.random() * IDLE_FIDGETS.length)],
      false
    );
    animState.addAnimation(0, ANIM.idle, true, 0);
    busyUntil = performance.now() + 2000;
    scheduleFidget(12000 + Math.random() * 12000);
  }
  let fidgetTimer = null;
  function scheduleFidget(delay) {
    clearTimeout(fidgetTimer);
    fidgetTimer = setTimeout(fidget, delay);
  }

  // ---------- 互动 3：点击 ----------
  let movedDistance = 0;
  canvas.addEventListener("click", () => {
    if (movedDistance > 12) return;
    if (!ready) return;
    setState("interact");
    say(QUOTES[Math.floor(Math.random() * QUOTES.length)]);
    idleSince = performance.now();
  });

  // ---------- 互动 4：拖拽 ----------
  let dragOffsetX = 0;
  let dragOffsetY = 0;

  canvas.addEventListener("pointerdown", (e) => {
    if (!ready) return;
    dragging = true;
    movedDistance = 0;
    ensurePositioned();
    const r = root.getBoundingClientRect();
    dragOffsetX = e.clientX - r.left;
    dragOffsetY = e.clientY - r.top;
    canvas.classList.add("dragging");
    try { canvas.setPointerCapture(e.pointerId); } catch {}
    setState("walk");
    idleSince = performance.now();
    e.preventDefault();
  });

  canvas.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    movedDistance += Math.abs(e.movementX || 0) + Math.abs(e.movementY || 0);
    posX = e.clientX - dragOffsetX;
    posY = e.clientY - dragOffsetY;
    clampPosition();
    applyPosition();
  });

  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    canvas.classList.remove("dragging");
    try { canvas.releasePointerCapture(e.pointerId); } catch {}
    setState("idle");
    idleSince = performance.now();
    if (movedDistance > 12) say("这里地质不错～");
    scheduleWander(5000);
  }
  canvas.addEventListener("pointerup", endDrag);
  canvas.addEventListener("pointercancel", endDrag);

  // 键盘可达性
  canvas.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      canvas.click();
    }
  });

  // ---------- 启动 ----------
  (async function boot() {
    try {
      status("waiting-runtime");
      const spine = await waitForSpine();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      setupCanvas();
      status("runtime-ok,dpr=" + dpr);

      const base = "/pet-eyja/";
      const [atlasText, skelBuf] = await Promise.all([
        fetch(base + "build_char_180_amgoat.atlas").then((r) => r.text()),
        fetch(base + "build_char_180_amgoat.skel").then((r) => r.arrayBuffer()),
      ]);

      const img = new Image();
      await new Promise((res, rej) => {
        img.onload = res;
        img.onerror = () => rej(new Error("texture load failed"));
        img.src = base + "build_char_180_amgoat.png";
      });

      const atlas = new spine.TextureAtlas(atlasText, () =>
        new spine.canvas.CanvasTexture(img)
      );
      const data = new spine.SkeletonBinary(
        new spine.AtlasAttachmentLoader(atlas)
      ).readSkeletonData(new Uint8Array(skelBuf));

      skeleton = new spine.Skeleton(data);
      // 把模型原点（脚底）放到画布的留白位置
      skeleton.x = ORIGIN_X * dpr;
      skeleton.y = ORIGIN_Y * dpr;
      skeleton.scaleX = dpr;
      skeleton.scaleY = -dpr;

      animState = new spine.AnimationState(new spine.AnimationStateData(data));

      // ⚠️ 构造函数要的是 2D 上下文，不是 canvas 元素
      ctx2d = canvas.getContext("2d");
      renderer = new spine.canvas.SkeletonRenderer(ctx2d);

      // ★ 必须开 triangleRendering。
      //   默认的 drawImages() 只处理 RegionAttachment，别的直接 continue ——
      //   方舟的头发/外套都是 MeshAttachment，不开就会被整片跳过（"没有头发"）。
      renderer.triangleRendering = true;

      ready = true;
      state = "";
      setState("idle");

      // 立即同步画一帧：标签页在后台时 rAF 会被节流，不能只等它
      drawFrame(0, performance.now());
      drawCount = 1;

      status("ready,vp=" + window.innerWidth + "x" + window.innerHeight);

      // 自检：数一下真实画出的像素
      try {
        const px = ctx2d.getImageData(0, 0, canvas.width, canvas.height).data;
        let n = 0;
        for (let i = 3; i < px.length; i += 4) if (px[i] > 8) n++;
        status("drawn=" + n);
      } catch (e) {
        status("probe-failed:" + e.message);
      }

      idleSince = performance.now();
      scheduleWander(7000);
      scheduleFidget(9000);
    } catch (err) {
      console.warn("[pet] 初始化失败：", err);
      status("ERROR: " + (err && err.message ? err.message : String(err)));
      root.style.display = "none";
    }
  })();

  requestAnimationFrame(tick);
</script>
