---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("blog", ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}`;

// 收集所有标签，供筛选
const tagCount = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="文章" description="全部文章与教程">
  <h1>文章列表</h1>

  {
    tags.length > 0 && (
      <p>
        {tags.map(([t, n]) => (
          <span class="tag">
            {t} · {n}
          </span>
        ))}
      </p>
    )
  }

  {
    posts.length === 0 ? (
      <div class="empty-state">
        <p>还没有文章。</p>
        <p style="font-size:.9em">
          在 <code>src/content/blog/</code> 新建 <code>.md</code> 文件即可，例如
          <code>hello.md</code>。
        </p>
      </div>
    ) : (
      <div class="slide-enter-content">
        {posts.map((post) => (
          <a class="post-item" href={`/posts/${post.id}`}>
            <div class="post-title">{post.data.title}</div>
            <div class="post-meta">
              <time>{fmt(post.data.date)}</time>
            </div>
            {post.data.description && <div class="post-desc">{post.data.description}</div>}
          </a>
        ))}
      </div>
    )
  }

  <p style="margin-top:24px">
    <a class="pushable" href="/">← 回到首页</a>
  </p>
</BaseLayout>
