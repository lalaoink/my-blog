---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hitokoto from "../components/Hitokoto.astro";
import { getCollection } from "astro:content";

// 取所有非草稿文章，按日期倒序（新的在前）
const all = await getCollection("blog", ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = posts.slice(0, 5);

// 日期格式：2026/09/23（和参考站一致）
const fmt = (d: Date) =>
  `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}`;
---

<BaseLayout>
  <h1>言与叶之庭</h1>

  <!-- 一言：标题正下方，点一下换一句 -->
  <Hitokoto />

  <p><em>把散落的字拾起来，种在叶子底下。</em></p>
  <p>
    这里放我自己写的文章与教程。想到什么写什么，写得慢，但都是真的。
  </p>

  <h2>最近</h2>

  {
    recent.length === 0 ? (
      <div class="empty-state">
        <p>还没有文章。</p>
        <p style="font-size:.9em">
          去 <code>src/content/blog/</code> 里新建一个 <code>.md</code> 文件，它就会出现在这里。
        </p>
      </div>
    ) : (
      <div class="slide-enter-content">
        {recent.map((post) => (
          <a class="post-item" href={`/posts/${post.id}`}>
            <div class="post-title">{post.data.title}</div>
            <div class="post-meta">
              <time>{fmt(post.data.date)}</time>
            </div>
            {post.data.description && <div class="post-desc">{post.data.description}</div>}
          </a>
        ))}
      </div>
    )
  }

  <p style="margin-top:24px">
    <a class="pushable" href="/posts">→ 全部文章</a>
  </p>
</BaseLayout>
