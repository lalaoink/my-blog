---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/bangumi.json";

// 这个 JSON 由 scripts/fetch-bangumi.mjs 生成（构建时静态导入，浏览器不请求 API）
const items = (data.items ?? []) as any[];
const counts = (data.counts ?? {}) as Record<string, number>;
const fetchedAt = data.fetchedAt ? new Date(data.fetchedAt) : null;

// 按收藏状态分组，顺序：在看 → 想看 → 看过 → 搁置 → 抛弃
const GROUPS = [
  { key: "在看", label: "在看", show: true },
  { key: "想看", label: "想看", show: true },
  { key: "看过", label: "看过", show: true },
  { key: "搁置", label: "搁置", show: false },
  { key: "抛弃", label: "抛弃", show: false },
];

const grouped = GROUPS.map((g) => ({
  ...g,
  items: items.filter((i) => i.collectionLabel === g.key),
})).filter((g) => g.items.length > 0);

const fmtDate = (s: string) => {
  if (!s) return "";
  const d = new Date(s);
  if (isNaN(d.valueOf())) return "";
  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}`;
};
---

<BaseLayout title="追番" description="我的 Bangumi 追番列表">
  <h1>追番</h1>

  <p>
    数据来自 <a href={`https://bgm.tv/user/${data.username}`} rel="noopener">Bangumi 番组计划</a>。
    每次构建时拉取一次，缓存成静态数据。
  </p>

  {
    fetchedAt && (
      <p style="font-size:.88em;color:var(--gray)">
        数据更新于 <time>{fmtDate(fetchedAt.toISOString())}</time>
      </p>
    )
  }

  {
    items.length === 0 ? (
      <div class="empty-state">
        <h2 style="margin-top:0">目前还没有公开的收藏</h2>
        <p>
          Bangumi 账号
          <a href={`https://bgm.tv/user/${data.username}`} rel="noopener">
            {data.username}
          </a>
          的动画收藏是空的，所以这里也没有东西可以显示。
        </p>
        <p style="font-size:.92em">
          去 Bangumi 把几部动画标成「在看」或「看过」，然后重新运行：
        </p>
        <pre
          style="text-align:left;background:#f6f6f4;border:2px solid var(--very-dark-gray);border-radius:8px;padding:10px;overflow-x:auto;font-size:.85em"
        ><code>$env:HTTPS_PROXY="http://127.0.0.1:7897"
$env:NODE_USE_ENV_PROXY="1"
node scripts/fetch-bangumi.mjs</code></pre>
        <p style="font-size:.88em">
          刷新页面即可看到你的追番墙。<br />
          若收藏设为私密，需要在 Bangumi 设置里改为公开，或改用 access token。
        </p>
      </div>
    ) : (
      <>
        <p>
          {GROUPS.filter((g) => (counts[g.key] ?? 0) > 0).map((g) => (
            <span class="tag">
              {g.label} {(counts[g.key] ?? 0)}
            </span>
          ))}
        </p>

        <div class="slide-enter-content">
          {grouped.map((group) => (
            <section>
              <h2>
                {group.label}
                <span style="font-size:.62em;font-weight:400;color:var(--gray)">
                  {" "}
                  · {group.items.length}
                </span>
              </h2>
              <div class="bgm-grid">
                {group.items.map((it) => (
                  <a
                    class="bgm-card"
                    href={`https://bgm.tv/subject/${it.id}`}
                    target="_blank"
                    rel="noopener"
                  >
                    <div class="bgm-cover">
                      {it.cover ? (
                        <img src={it.cover} alt={it.nameCn || it.name} loading="lazy" />
                      ) : (
                        <div class="bgm-nocover">无封面</div>
                      )}
                    </div>
                    <div class="bgm-info">
                      <div class="bgm-name">{it.nameCn || it.name}</div>
                      <div class="bgm-sub">{it.nameCn ? it.name : ""}</div>
                      <div class="bgm-meta">
                        {it.eps > 0 && <span>{it.epStatus}/{it.eps} 集</span>}
                        {it.score > 0 && <span>★ {it.score}</span>}
                        {it.myRate > 0 && <span class="bgm-myrate">我 {it.myRate}</span>}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </>
    )
  }

  <p style="margin-top:24px">
    <a class="pushable" href="/">← 回到首页</a>
  </p>
</BaseLayout>

<style>
  .bgm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 14px;
    margin-bottom: 1em;
  }

  .bgm-card {
    display: block;
    border: 2px solid var(--very-dark-gray);
    border-radius: 8px;
    overflow: hidden;
    color: inherit;
    transition: all 0.18s cubic-bezier(0.45, 0.05, 0.55, 0.95);
    background: #fff;
  }
  .bgm-card:hover {
    text-decoration: none;
    transform: translateY(-3px);
    border-color: var(--sea-blue);
    box-shadow: 0 6px 16px rgba(49, 111, 211, 0.18);
  }

  .bgm-cover {
    aspect-ratio: 3 / 4;
    background: #f3f3f1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .bgm-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bgm-nocover {
    color: var(--gray);
    font-size: 0.8em;
  }

  .bgm-info {
    padding: 6px 8px 8px;
    border-top: 2px solid var(--very-dark-gray);
  }
  .bgm-name {
    font-size: 0.86em;
    font-weight: 700;
    color: var(--very-dark-gray);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bgm-sub {
    font-size: 0.72em;
    color: var(--gray);
    line-height: 1.25;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bgm-meta {
    font-size: 0.76em;
    color: var(--gray);
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bgm-myrate {
    color: var(--sea-blue);
    font-weight: 700;
  }
</style>
